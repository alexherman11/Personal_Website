# --- Narrator ---
# Anthropic API key for the narrator (Claude). Leave unset to fall back to
# ~/.claude/.credentials.json (OAuth) or, as a last resort, a local `claude` CLI.
ANTHROPIC_API_KEY=sk-ant-...
# Force a transport: api | claude-cli   (default: api key -> OAuth -> claude CLI)
# NARRATOR_BACKEND=claude-cli
# NARRATOR_MODEL=claude-sonnet-5

# --- Server ---
PORT=3002
CORS_ORIGIN=http://localhost:5176

# --- The world ---
# Where the world database lives (journal + snapshots). On Railway/Render/Fly
# point this at a persistent volume, or every deploy wipes what visitors built.
# WORLD_DATA_DIR=/data/world
# Password for the wizard account "Alex" (connect alex <password> in-game).
WIZARD_PASSWORD=

# --- Private admin pages (/private, /private/mail) ---
# Without these, /private returns 503.
PRIVATE_ADMIN_USER=
PRIVATE_ADMIN_PASSWORD=

# --- Foreman console (optional) ---
FOREMAN_API_BASE=https://foreman.agoraserver.com
FOREMAN_MCP_TOKEN=
FOREMAN_DEFAULT_REPO_HINT=/mnt/c/Projects/Anima
